# Sierra demo — required env vars
# Copy this file to .env.local and fill in real values
# For Vercel: set these in project settings → environment variables (Production + Preview)

ANTHROPIC_API_KEY=sk-ant-api03-...
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Open config — env-tunable runtime knobs (see README)
SIERRA_MODEL_ID=claude-sonnet-4-5
SIERRA_RATE_LIMIT_PER_MIN=10
SIERRA_DAILY_CAP_USD=5.00
SIERRA_STOP_AFTER_STEPS=20

# Phase 1.1 — voice toggle (optional, public agent id)
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
